#!/usr/bin/env bash
set -euo pipefail

not_configured() {
    local phase="$1"
    printf 'ERROR: %s is not configured. Copy this template and replace every phase with the repository command.\n' "$phase" >&2
    return 2
}

run_build() {
    # Example: cmake --build build
    not_configured "Build"
}

run_tests() {
    # Example: ctest --test-dir build --output-on-failure
    not_configured "Test"
}

run_lizard() {
    # Report-only baseline example (not a ratchet by itself):
    # lizard -C 10 -T nloc=80 -a 6 -i -1 src include
    # Add a per-function before/after comparison or a new-function gate here.
    not_configured "Lizard and its ratchet"
}

run_clang_tidy() {
    # Merge the required checks and thresholds into the existing .clang-tidy.
    # Example: run-clang-tidy -p build
    not_configured "clang-tidy"
}

echo "=== Build ==="
run_build

echo "=== Test ==="
run_tests

echo "=== Lizard ==="
run_lizard

echo "=== clang-tidy ==="
run_clang_tidy

echo "=== Quality check completed ==="
